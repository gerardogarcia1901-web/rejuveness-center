---
import '../styles/global.css';
import BookingModal from '../components/BookingModal.astro';
import { CLINIC_INFO } from '../data/clinicData';

interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
}

const {
  title = 'REJUVENESS CENTER · Clínica de Medicina Estética en San Salvador',
  description = 'Clínica de rejuvenecimiento facial, armonización orofacial progresiva, regeneración celular avanzada y moldeo corporal bajo la dirección de la Dra. Ingrid Gómez en Colonia Maquilishuat, San Salvador.',
  currentPath = Astro.url.pathname,
} = Astro.props;

const navLinks = [
  { href: '/', label: 'Inicio' },
  { href: '/nosotros', label: 'Nosotros' },
  { href: '/procedimientos', label: 'Procedimientos' },
  { href: '/resultados', label: 'Resultados' },
  { href: '/contacto', label: 'Contacto' },
];

function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#FCFAF8" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- Google Fonts: Inter (200, 300, 400, 500, 600) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@200;300;400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="bg-ivory font-sans text-ink antialiased selection:bg-rose-nude selection:text-rose-dark">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:px-5 focus:py-2.5 focus:bg-rose-dark focus:text-ivory-pure text-xs uppercase tracking-editorial"
    >
      Saltar al contenido principal
    </a>

    <!-- Sticky Minimalist Header with the Shared Logo Only (No extra text) -->
    <header
      id="site-header"
      class="sticky top-0 left-0 right-0 z-50 bg-ivory-pure/95 backdrop-blur-md border-b border-gold-border/70 transition-all duration-300"
    >
      <div class="h-20 sm:h-22 max-w-[1440px] mx-auto px-5 sm:px-8 lg:px-12 flex items-center justify-between gap-4">
        <!-- Official Shared Logo Image Only -->
        <a href="/" aria-label="Ir al inicio de Rejuveness Center" class="flex items-center shrink-0 focus:outline-none">
          <img
            src="/images/logo-header.png"
            alt="REJUVENESS Center · Clínica de Rejuvenecimiento Facial y Moldeo Corporal"
            width="210"
            height="118"
            class="h-14 sm:h-16 w-auto object-contain"
          />
        </a>

        <!-- Desktop Navigation (5 Required Pages) -->
        <nav aria-label="Navegación principal" class="hidden xl:flex items-center gap-9">
          {navLinks.map((link) => {
            const active = isActive(link.href);
            return (
              <a
                href={link.href}
                aria-current={active ? 'page' : undefined}
                class={`relative py-1.5 text-[10.5px] uppercase tracking-[0.24em] link-editorial ${
                  active
                    ? 'text-rose-dark font-medium after:absolute after:bottom-0 after:left-0 after:w-full after:h-[1.5px] after:bg-gold-metallic'
                    : 'text-ink-muted hover:text-rose-dark'
                }`}
              >
                {link.label}
              </a>
            );
          })}
        </nav>

        <!-- Right CTA Actions -->
        <div class="flex items-center gap-4">
          <a
            href={`tel:${CLINIC_INFO.phoneTel}`}
            class="hidden md:inline-flex items-center gap-1.5 text-[10.5px] uppercase tracking-[0.2em] text-ink-muted hover:text-gold-deep link-editorial"
          >
            <span>Tel. 2264-7018</span>
          </a>

          <button
            type="button"
            data-open-booking
            class="btn-atelier hidden sm:inline-flex items-center justify-center px-6 py-3 bg-rose-dark text-ivory-pure text-[10px] font-medium uppercase tracking-[0.24em] hover:bg-rose-old hover:text-rose-espresso focus:outline-none focus-visible:ring-2 focus-visible:ring-gold-metallic"
          >
            <span>Agendar Cita</span>
          </button>

          <!-- Mobile Menu Button -->
          <button
            type="button"
            id="mobile-menu-toggle"
            aria-label="Abrir menú de navegación"
            aria-expanded="false"
            class="xl:hidden flex h-10 w-10 items-center justify-center border border-gold-border text-rose-dark hover:bg-rose-blush/50 focus:outline-none"
          >
            <svg
              id="menu-icon-open"
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <line x1="4" y1="7" x2="20" y2="7"></line>
              <line x1="4" y1="12" x2="20" y2="12"></line>
              <line x1="4" y1="17" x2="20" y2="17"></line>
            </svg>
            <svg
              id="menu-icon-close"
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="hidden"
            >
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>
      </div>

      <!-- Mobile Navigation Drawer -->
      <div
        id="mobile-menu-drawer"
        class="xl:hidden hidden bg-ivory-pure border-b border-gold-border px-6 py-7 space-y-6"
      >
        <nav aria-label="Navegación móvil" class="flex flex-col space-y-4">
          {navLinks.map((link) => {
            const active = isActive(link.href);
            return (
              <a
                href={link.href}
                class={`text-[13px] uppercase tracking-[0.24em] py-1.5 border-b border-gold-border/40 ${
                  active ? 'text-rose-dark font-medium' : 'text-ink-muted'
                }`}
              >
                {link.label}
              </a>
            );
          })}
        </nav>

        <div class="space-y-3 pt-2">
          <button
            type="button"
            data-open-booking
            class="btn-atelier w-full py-3.5 bg-rose-dark text-ivory-pure text-[10.5px] font-medium uppercase tracking-[0.24em]"
          >
            Agendar Evaluación Médica
          </button>
          <div class="flex items-center justify-between text-[11px] text-ink-muted pt-1">
            <a href={`tel:${CLINIC_INFO.phoneTel}`} class="hover:text-rose-dark">
              Tel: {CLINIC_INFO.phoneDisplay}
            </a>
            <a
              href={`https://wa.me/${CLINIC_INFO.whatsappPrimaryNumber}`}
              target="_blank"
              rel="noopener noreferrer"
              class="text-gold-deep font-medium"
            >
              WA: {CLINIC_INFO.whatsappPrimaryDisplay}
            </a>
          </div>
        </div>
      </div>
    </header>

    <!-- Main Page Content -->
    <main id="main-content" class="w-full min-h-screen">
      <slot />
    </main>

    <!-- Floating WhatsApp Concierge Pill -->
    <div class="fixed bottom-6 right-6 z-40">
      <a
        href={`https://wa.me/${CLINIC_INFO.whatsappPrimaryNumber}?text=Hola%20Rejuveness%20Center,%20deseo%20informaci%C3%B3n%20sobre%20evaluaci%C3%B3n%20m%C3%A9dica%20y%20procedimientos.`}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Contactar recepción médica de Rejuveness Center por WhatsApp"
        class="btn-atelier flex items-center gap-3 bg-ivory-pure/95 backdrop-blur-md text-rose-dark px-5 py-3.5 shadow-[0_12px_34px_rgba(52,28,33,0.12)] border border-gold-metallic/60 hover:bg-rose-dark hover:text-ivory-pure hover:border-rose-dark group"
      >
        <span class="relative flex h-2.5 w-2.5">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-rose-old opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-gold-metallic"></span>
        </span>
        <span class="text-[10px] font-medium uppercase tracking-[0.24em]">
          WhatsApp Citas
        </span>
      </a>
    </div>

    <!-- SIMPLE, SERENE & ELEGANT FOOTER -->
    <footer class="w-full bg-[#F7EEEC] text-rose-dark border-t border-gold-border/80 pt-16 pb-12">
      <div class="max-w-[1380px] mx-auto px-5 sm:px-8 lg:px-12">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-12 items-start pb-14 border-b border-gold-border/70">
          <!-- Column 1: Logo & Essence (4 cols) -->
          <div class="lg:col-span-4 space-y-5">
            <a href="/" class="inline-block">
              <img
                src="/images/logo-header.png"
                alt="REJUVENESS Center"
                width="190"
                height="106"
                loading="lazy"
                class="h-14 w-auto object-contain"
              />
            </a>
            <p class="text-[13.5px] text-ink-muted leading-relaxed max-w-xs">
              Armonización facial progresiva y regeneración celular natural bajo la dirección de la Dra. Ingrid Gómez desde 2012.
            </p>
            <div class="flex items-center gap-5 pt-1 text-[10.5px] font-medium uppercase tracking-[0.22em] text-rose-deep">
              <a
                href={CLINIC_INFO.instagramUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="hover:text-rose-dark link-editorial"
              >
                Instagram
              </a>
              <span class="text-gold-metallic">·</span>
              <a
                href={CLINIC_INFO.facebookUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="hover:text-rose-dark link-editorial"
              >
                Facebook
              </a>
            </div>
          </div>

          <!-- Column 2: Navigation (2 cols) -->
          <div class="lg:col-span-2 space-y-3.5">
            <span class="text-[10px] font-medium uppercase tracking-[0.26em] text-gold-deep block">
              Menú
            </span>
            <ul class="space-y-2.5 text-[13.5px] text-ink-muted">
              {navLinks.map((link) => (
                <li>
                  <a href={link.href} class="hover:text-rose-dark link-editorial">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <!-- Column 3: Location & Direct Contact (3 cols) -->
          <div class="lg:col-span-3 space-y-3.5">
            <span class="text-[10px] font-medium uppercase tracking-[0.26em] text-gold-deep block">
              Contacto
            </span>
            <p class="text-[13.5px] text-ink-muted leading-relaxed">
              Calle La Mascota #722,<br />
              Colonia Maquilishuat,<br />
              San Salvador, El Salvador.
            </p>
            <div class="pt-1 space-y-1 text-[13.5px]">
              <a
                href={`tel:${CLINIC_INFO.phoneTel}`}
                class="block text-rose-dark hover:text-gold-deep link-editorial"
              >
                Tel. {CLINIC_INFO.phoneDisplay}
              </a>
              <a
                href={`https://wa.me/${CLINIC_INFO.whatsappPrimaryNumber}`}
                target="_blank"
                rel="noopener noreferrer"
                class="block text-rose-deep hover:text-rose-dark link-editorial"
              >
                WhatsApp {CLINIC_INFO.whatsappPrimaryDisplay}
              </a>
            </div>
          </div>

          <!-- Column 4: Serene Aesthetic Image (3 cols) -->
          <div class="lg:col-span-3 flex lg:justify-end">
            <div class="w-[220px] h-[250px] shrink-0 overflow-hidden bg-ivory-pure p-2 border border-gold-border/80 shadow-sm">
              <img
                src="/images/pexels/footer-serene.jpg"
                alt="Cuidado facial y armonía estética en Rejuveness Center"
                width="360"
                height="405"
                class="block w-full h-full object-cover object-center"
              />
            </div>
          </div>
        </div>

        <!-- Clean Minimal Copyright Line -->
        <div class="pt-7 flex flex-col sm:flex-row items-center justify-between gap-4 text-[12px] text-ink-muted">
          <p>© {new Date().getFullYear()} REJUVENESS CENTER · Todos los derechos reservados.</p>
          <p class="text-[10px] uppercase tracking-[0.22em] text-gold-deep">
            San Salvador · El Salvador
          </p>
        </div>
      </div>
    </footer>

    <!-- Global Quick Booking Modal -->
    <BookingModal />

    <!-- Mobile Menu & Scroll Reveal Choreography -->
    <script>
      function initLayoutScripts() {
        const menuToggle = document.getElementById('mobile-menu-toggle');
        const menuDrawer = document.getElementById('mobile-menu-drawer');
        const iconOpen = document.getElementById('menu-icon-open');
        const iconClose = document.getElementById('menu-icon-close');

        if (menuToggle && menuDrawer && menuToggle.getAttribute('data-bound') !== 'true') {
          menuToggle.setAttribute('data-bound', 'true');
          menuToggle.addEventListener('click', () => {
            const expanded = menuToggle.getAttribute('aria-expanded') === 'true';
            menuToggle.setAttribute('aria-expanded', (!expanded).toString());
            menuDrawer.classList.toggle('hidden');
            iconOpen?.classList.toggle('hidden');
            iconClose?.classList.toggle('hidden');
          });
        }

        // Subtle IntersectionObserver reveal
        const revealEls = document.querySelectorAll('[data-reveal]');
        if ('IntersectionObserver' in window) {
          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-revealed');
                  observer.unobserve(entry.target);
                }
              });
            },
            { threshold: 0.08, rootMargin: '0px 0px -30px 0px' }
          );
          revealEls.forEach((el) => observer.observe(el));
        } else {
          revealEls.forEach((el) => el.classList.add('is-revealed'));
        }
      }

      initLayoutScripts();
      document.addEventListener('astro:page-load', initLayoutScripts);
    </script>
  </body>
</html>
